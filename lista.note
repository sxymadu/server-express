import express from 'express';
const app = express();
const port = 3000;

app.use(express.json());

app.get('/', (req, res) => {
    res.send('Seja bem-vindo a pagina da curso!');
});

app.get('/cursos', (req, res) => {
    res.send([
        {id: 1, nome: 'Curso de JavaScript'},
        {id: 2, nome: 'Curso de Python'},
        {id: 3, nome: 'Curso de Java'}
    ]);
});

app.get('/professores', (req, res) => {
    res.send([
        {id: 1, nome: 'Prof. João'},
        {id: 2, nome: 'Prof. Maria'},
        {id: 3, nome: 'Prof. Pedro'}
    ]);
});

app.get('/contato', (req, res) => {
    res.send([
        {id: 1, email: 'prof.joao_@exemplo.com'},
        {id: 2, email: 'maria_professora@exemplo.com'},
        {id: 3, email: 'pedro.fonseca.prof@exemplo.com'}
    ])
});

app.get('/produtos', (req, res) => {
    res.send([
        {id: 1, nome: 'Teclado', preco: 130.00},
        {id: 2, nome: 'Mouse', preco: 55.00},
        {id: 3, nome: 'Monitor', preco: 200.00},
        {id: 4, nome: 'Notebook', preco: 1500.00},
        {id: 5, nome: 'Desktop', preco: 2500.00}
    ]);
});

app.listen(3000, () => {});

app.get('/produtos/:id', (req, res) => {
    const id = Number(req.params.id);
    const produtos = [
        { id: 1, nome: 'Teclado', preco: 130.00 },
        { id: 2, nome: 'Mouse', preco: 55.00 },
        { id: 3, nome: 'Monitor', preco: 200.00 },
        { id: 4, nome: 'Notebook', preco: 1500.00 },
        { id: 5, nome: 'Desktop', preco: 2500.00 }
    ];

    const produto = produtos.find(p => p.id === id);

    if (produto) {
        res.send(produto);
    } else {
        res.status(404).send({ error: 'Produto não encontrado' });
    }
});


app.listen(3000, () => {
    console.log('Servidor rodando na porta 3000');
    });

    app.get('/', (req, res) => {
    res.status(200).json({
        mensagem: "Calculadora!",
        exemplos_de_uso: [
            "/somar/10/5",
            "/subtrair/10/5",
            "/multiplicar/10/5",
            "/dividir/10/5"
        ]
    });
});

app.get('/somar/:n1/:n2', (req, res) => {
    const n1 = Number(req.params.n1);
    const n2 = Number(req.params.n2);
    
    const resultado = n1 + n2;
    res.status(200).json({ resultado });
});

app.get('/subtrair/:n1/:n2', (req, res) => {
    const n1 = Number(req.params.n1);
    const n2 = Number(req.params.n2);
    
    const resultado = n1 - n2;
    res.status(200).json({ resultado });
});

app.get('/multiplicar/:n1/:n2', (req, res) => {
    const n1 = Number(req.params.n1);
    const n2 = Number(req.params.n2);
    
    const resultado = n1 * n2;
    res.status(200).json({ resultado });
});

app.get('/dividir/:n1/:n2', (req, res) => {
    const n1 = Number(req.params.n1);
    const n2 = Number(req.params.n2);
    
    const resultado = n1/n2;
    res.status(200).json({ resultado });
});

    app.listen(3000, () =>{
        console.log('Servidor rodando na porta 3000')
    });

    let tarefas = [
    { id: 1, titulo: 'Estudar JavaScript', concluida: false },
    { id: 2, titulo: 'Configurar rotas no Postman', concluida: true }
];

let proximoId = 3;

app.get('/tarefas', (req, res) => {
    res.send(tarefas);
});

app.get('/tarefas/:id', (req, res) => {
    const id = Number(req.params.id);
    const tarefa = tarefas.find(t => t.id === id);

    if (tarefa) {
        res.send(tarefa);
    } else {
        res.status(404).send({ error: 'Tarefa não encontrada' });
    }
});


app.post('/tarefas', (req, res) => {
    const titulo = req.body.titulo;

    if (!titulo) {
        return res.status(400).send({ error: "O campo 'titulo' é obrigatório" });
    }

    const novaTarefa = {
        id: proximoId,
        titulo: titulo,
        concluida: false
    };

    tarefas.push(novaTarefa);
    proximoId++;

    res.status(201).send(novaTarefa);
});


app.delete('/tarefas/:id', (req, res) => {
    const id = Number(req.params.id);
    const indice = tarefas.findIndex(t => t.id === id);

    if (indice !== -1) {
        tarefas.splice(indice, 1);
        res.send({ mensagem: 'Tarefa removida com sucesso' });
    } else {
        res.status(404).send({ error: 'Tarefa não encontrada' });
    }
});

app.listen(port, () => {
    console.log(`Servidor de tarefas rodando na porta ${port}`);
});